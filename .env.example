# ============================================================================
# Jina's Lite — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env itself.
# ============================================================================

# ─── Supabase (frontend) ────────────────────────────────────────────────────
# Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ─── Cloudflare R2 (product images CDN) ─────────────────────────────────────
# Public base URL for your R2 bucket / custom domain.
# Image URL pattern used by the app: {VITE_IMAGE_BASE_URL}/{sku}.webp
VITE_IMAGE_BASE_URL=https://images.jinaslite.com

# ─── Admin portal ────────────────────────────────────────────────────────────
# Soft, client-side password gate only — falls back to 'jina2026' if unset.
# Real write protection comes from Supabase RLS + the `admins` table, not this.
VITE_ADMIN_PASSWORD=jina2026

# ─── Stripe (optional) ───────────────────────────────────────────────────────
# Leave blank in dev to use the built-in mock checkout flow.
# Set this (pk_live_... / pk_test_...) to switch to the real Stripe path.
VITE_STRIPE_PUBLISHABLE_KEY=

# ============================================================================
# The variables below are NOT prefixed with VITE_, so Vite never bundles
# them into client-side code. They're read by Node scripts / Edge Functions
# only — set them in your shell or CI, not in the browser-facing build.
# ============================================================================

# ─── scripts/import-products.mjs (bulk CSV import) ──────────────────────────
# Use the SERVICE ROLE key here, never the anon key.
#   node src/scripts/import-products.mjs --file=products.csv
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# ─── supabase/functions/create-payment-intent (Edge Function) ──────────────
# This is NOT read from .env — it's a Supabase secret. Set it with:
#   supabase secrets set STRIPE_SECRET_KEY=sk_live_...
# Listed here only so you don't forget to set it after redeploying functions.
# STRIPE_SECRET_KEY=sk_live_...
